parameters:
    level: 7
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Method .+ConcreteProductsReader::findProductConcreteBySku\(\) should return .+RestResourceInterface\|null but returns .+RestResourceInterface\|false#'
        - '#Method .+ConcreteProductsReader::findProductConcreteById\(\) should return .+RestResourceInterface\|null but returns .+RestResourceInterface\|false#'
        -
            identifier: missingType.iterableValue
        - '#PHPDoc tag @Glue has invalid value#'
#        API Platform Generated resource classes are intentionally excluded from generation
#        (see config/GlueStorefront/packages/spryker_api_platform.php).
        - '#invalid type Generated\\Api\\Storefront\\AbstractProductsStorefrontResource\.#'
        - '#invalid return type Generated\\Api\\Storefront\\AbstractProductsStorefrontResource\.#'
        - '#unknown class Generated\\Api\\Storefront\\AbstractProductsStorefrontResource\.#'
        - '#Instantiated class Generated\\Api\\Storefront\\AbstractProductsStorefrontResource not found\.#'
        - '#invalid type Generated\\Api\\Storefront\\ConcreteProductsStorefrontResource\.#'
        - '#invalid return type Generated\\Api\\Storefront\\ConcreteProductsStorefrontResource\.#'
        - '#unknown class Generated\\Api\\Storefront\\ConcreteProductsStorefrontResource\.#'
        - '#Instantiated class Generated\\Api\\Storefront\\ConcreteProductsStorefrontResource not found\.#'
